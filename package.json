{
  "name": "dsh-web-search-yuanbao",
  "description": "Tencent Yuanbao Search-backed search provider for the DeepSeek Harness web capability seam (ctx.web)",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf lib",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check": "pnpm run typecheck && pnpm run test",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-web": "^0.2.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-http-proxy": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-web": "0.2.1-rc.2",
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
